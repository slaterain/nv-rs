* text=auto
*.rs text eol=lf
*.wgsl text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
# An open call has an empty final system column; its trailing tab is data.
research/engine-map/frame_wiring.tsv text eol=lf whitespace=-blank-at-eol
# UIO 2.30's own list, embedded byte for byte (CRLF lines, no line end at the end).
crates/uio/data/supported.txt -text
# The machine table's fixed Windows answers, read with include_str!: the same bytes on every checkout.
crates/engine-platform/data/machine/*.tsv text eol=lf
# Real zone files (IANA tzdata, public domain) as hex text for the machine table's tests.
crates/engine-platform/data/machine/zoneinfo/*.hex text eol=lf
